# Google Gemini API Key (default AI provider for Stack-Chan)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional default provider for Xiaozhi voice bridge ask_ai tool
ASK_AI_PROVIDER=gemini

# Optional Xiaozhi MCP WebSocket endpoint (wss://api.xiaozhi.me/mcp/?token=...)
XIAOZHI_MCP_URL=

# Optional USB serial port for custom Stack-Chan firmware (auto-detected if unset)
STACKCHAN_SERIAL_PORT=/dev/cu.usbmodem2101

# Local control panel port (binds to 127.0.0.1 only)
PORT=3000
